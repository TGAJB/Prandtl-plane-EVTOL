digraph "module_dependencies" {
  rankdir=LR;
  labelloc="t";
  label="Module dependency graph (static imports, clustered by subsystem)";
  fontname="Helvetica"; fontsize=16;
  node [fontname="Helvetica", style="rounded,filled"];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.7];
  compound=true;
  subgraph "cluster_class_II_sizing" {
    label="class_II_sizing"; style="filled,rounded"; color="#bbbbbb"; fillcolor="#dbe9fb"; fontname="Helvetica-Bold"; fontsize=12;
    "class_II_sizing/energy" [label="energy", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=12];
    "class_II_sizing/fuselage_sizing_plots" [label="fuselage_sizing_plots", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "class_II_sizing/landing_gear_sensitivity" [label="landing_gear_sensitivity", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "class_II_sizing/landing_gear_sketch" [label="landing_gear_sketch", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
    "class_II_sizing/loading diagram (bubble diagram)" [label="loading diagram (bubble diagram)", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
    "class_II_sizing/mass_components" [label="mass_components", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=17];
    "class_II_sizing/MMOI" [label="MMOI", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=14];
    "class_II_sizing/mtow_sizing" [label="mtow_sizing", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=23];
    "class_II_sizing/pressurization_sizing" [label="pressurization_sizing", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "class_II_sizing/trade_off_landing_gear" [label="trade_off_landing_gear", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
  }
  subgraph "cluster_final_characteristics" {
    label="final_characteristics"; style="filled,rounded"; color="#bbbbbb"; fillcolor="#e2efda"; fontname="Helvetica-Bold"; fontsize=12;
    "final_characteristics/aero_calibration" [label="aero_calibration", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "final_characteristics/aero_model" [label="aero_model", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=12];
    "final_characteristics/aeroacoustics" [label="aeroacoustics", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
    "final_characteristics/aux_loads" [label="aux_loads", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=12];
    "final_characteristics/battery_cells" [label="battery_cells", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "final_characteristics/control" [label="control", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=13];
    "final_characteristics/ecs_sizing" [label="ecs_sizing", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "final_characteristics/FBD_Generator_wing" [label="FBD_Generator_wing", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
    "final_characteristics/matching_diagram" [label="matching_diagram", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=12];
    "final_characteristics/optimiser" [label="optimiser", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "final_characteristics/ppe" [label="ppe", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=12];
    "final_characteristics/stability_eval" [label="stability_eval", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=13];
    "final_characteristics/stability_sensitivity" [label="stability_sensitivity", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "final_characteristics/structures" [label="structures", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
    "final_characteristics/test file" [label="test file", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
  }
  subgraph "cluster_final_characteristics_aerodynamics" {
    label="final_characteristics/aerodynamics"; style="filled,rounded"; color="#bbbbbb"; fillcolor="#fce4ec"; fontname="Helvetica-Bold"; fontsize=12;
    "final_characteristics/aerodynamics/airfoil_validation/airfoil_characteristics" [label="airfoil_characteristics", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "final_characteristics/aerodynamics/dragpolar" [label="dragpolar", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "final_characteristics/aerodynamics/h_b determination/h_b_lift_ratio" [label="h_b_lift_ratio", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
  }
  subgraph "cluster_final_characteristics_structures" {
    label="final_characteristics/structures"; style="filled,rounded"; color="#bbbbbb"; fillcolor="#ece3f6"; fontname="Helvetica-Bold"; fontsize=12;
    "final_characteristics/structures/hinge_loading" [label="hinge_loading", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=13];
    "final_characteristics/structures/hinge_loading_unit_tests" [label="hinge_loading_unit_tests", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "final_characteristics/structures/landing_gear_sizing" [label="landing_gear_sizing", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
    "final_characteristics/structures/legacy_code" [label="legacy_code", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "final_characteristics/structures/print them VECTORS" [label="print them VECTORS", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
    "final_characteristics/structures/test" [label="test", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
    "final_characteristics/structures/winglet_sizing" [label="winglet_sizing", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
    "final_characteristics/structures/winglet_sizing_global" [label="winglet_sizing_global", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
  }
  subgraph "cluster_final_characteristics_vehicle_dynamics" {
    label="final_characteristics/vehicle_dynamics"; style="filled,rounded"; color="#bbbbbb"; fillcolor="#d9eef1"; fontname="Helvetica-Bold"; fontsize=12;
    "final_characteristics/vehicle_dynamics/aircraft" [label="aircraft", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=16];
    "final_characteristics/vehicle_dynamics/dyn_stab_analysis" [label="dyn_stab_analysis", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "final_characteristics/vehicle_dynamics/stat_long_stab_anal" [label="stat_long_stab_anal", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "final_characteristics/vehicle_dynamics/stat_long_stab_anal_func" [label="stat_long_stab_anal_func", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=13];
    "final_characteristics/vehicle_dynamics/stat_long_stab_anal_vtol_oei_plot" [label="stat_long_stab_anal_vtol_oei_plot", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
    "final_characteristics/vehicle_dynamics/VTOL_cg_envelope_det" [label="VTOL_cg_envelope_det", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=14];
  }
  subgraph "cluster_fusion" {
    label="fusion"; style="filled,rounded"; color="#bbbbbb"; fillcolor="#eeeeee"; fontname="Helvetica-Bold"; fontsize=12;
    "fusion/fuselage/fuselage" [label="fuselage", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
    "fusion/fusion_params" [label="fusion_params", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
    "fusion/hub/hub" [label="hub", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
    "fusion/propeller_blade/propeller_blade" [label="propeller_blade", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=11];
  }
  subgraph "cluster_root" {
    label="root"; style="filled,rounded"; color="#bbbbbb"; fillcolor="#fde9d9"; fontname="Helvetica-Bold"; fontsize=12;
    "fusion_geometry" [label="fusion_geometry", shape=box, fillcolor="#ffffff", color="#555555", penwidth=1.0, fontsize=12];
    "parameters" [label="parameters", shape=box, fillcolor="#ffd966", color="#bf9000", penwidth=2.2, fontsize=23];
  }
  subgraph "cluster_initial_sizing" {
    label="initial_sizing"; style="filled,rounded"; color="#bbbbbb"; fillcolor="#f2f2f2"; fontname="Helvetica-Bold"; fontsize=12;
    "initial_sizing/init_wing_sizing" [label="init_wing_sizing", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=11];
  }
  subgraph "cluster_support_files" {
    label="support_files"; style="filled,rounded"; color="#bbbbbb"; fillcolor="#fff2cc"; fontname="Helvetica-Bold"; fontsize=12;
    "support_files/oswaldefficiency" [label="oswaldefficiency", shape=box, fillcolor="#eaf5ea", color="#2e7d32", penwidth=2.0, fontsize=14];
  }
