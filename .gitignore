# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Python environments and packaging
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Test, coverage, and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local configuration and secrets
.env
.env.*

# Editor and OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak
~$*

# final_design runner: the active design override + generated results are TRACKED
# (committed) so that running run_design and pushing updates them for the whole team.
# Nothing here is ignored; commit & push after a run to share the regenerated outputs.
